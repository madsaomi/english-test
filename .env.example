# Токен Telegram-бота от @BotFather (если оставить пустым, сервер запустится в ДЕМО-режиме)
BOT_TOKEN=

# ID чата администратора или канала/группы (куда присылать результаты тестов)
# Можно узнать свой ID через бота @userinfobot в Telegram
ADMIN_CHAT_ID=

# Настройки сервера
HOST=0.0.0.0
PORT=8000

# Публичный URL вашего сервера (для Telegram WebApp кнопки в боте)
# Локально: http://localhost:8000, для продакшна: https://your-domain.com
WEBAPP_URL=http://localhost:8000

# Разрешённые CORS-origin через запятую (пусто = все origins, для прода укажите свой домен)
# Пример: ALLOWED_ORIGINS=https://english-test.up.railway.app
ALLOWED_ORIGINS=
